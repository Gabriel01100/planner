# Generate a long random token for the historical personal workspace; OIDC users are isolated.
CALENFLEX_TOKEN=
DATABASE_URL=sqlite:///./data/calenflex.db
# Optional: OpenAI-compatible provider. Never put these credentials in Android.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_REQUESTS_PER_HOUR=20

# Optional external OAuth/OIDC resource-server configuration for ChatGPT MCP.
# All three URLs must be HTTPS and belong to a real configured provider/deployment.
OAUTH_ISSUER=
OAUTH_JWKS_URL=
OAUTH_RESOURCE_URL=

# Server-side authenticated encryption. Generate locally and keep a secure backup.
# Set CALENFLEX_ENV=production only after configuring the key and HTTPS.
CALENFLEX_ENV=development
CALENFLEX_DATA_KEY=

# Production Compose: real DNS domain, URL-safe password generated locally (for example hex).
PUBLIC_DOMAIN=
POSTGRES_PASSWORD=
# Empty means no cross-origin browser access. Never use wildcard origins for an account UI.
CORS_ORIGINS=
# Production Compose sets this to the public domain plus internal health-check hosts.
ALLOWED_HOSTS=

# Public SPA client for /connect (authorization-code PKCE S256; never a client secret).
OIDC_LINK_CLIENT_ID=
OIDC_AUDIENCE_PARAMETER=resource
