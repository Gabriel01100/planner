# Generate a long random token; one server instance corresponds to one personal workspace.
CALENFLEX_TOKEN=
DATABASE_URL=sqlite:///./data/calenflex.db
# Optional: OpenAI-compatible provider. Never put these credentials in Android.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_REQUESTS_PER_HOUR=20

# Optional external OAuth/OIDC resource-server configuration for ChatGPT MCP.
# All three URLs must be HTTPS and belong to a real configured provider/deployment.
OAUTH_ISSUER=
OAUTH_JWKS_URL=
OAUTH_RESOURCE_URL=

# Server-side authenticated encryption. Generate locally and keep a secure backup.
# Set CALENFLEX_ENV=production only after configuring the key and HTTPS.
CALENFLEX_ENV=development
CALENFLEX_DATA_KEY=
